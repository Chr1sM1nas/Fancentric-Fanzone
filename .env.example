# ZITADEL OIDC (Authorization Code + PKCE)
# Copy this file to .env.local and fill with your project values.

VITE_ZITADEL_AUTHORITY=https://your-zitadel-instance
VITE_ZITADEL_CLIENT_ID=your-client-id
VITE_ZITADEL_REDIRECT_URI=http://localhost:5173
VITE_ZITADEL_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_ZITADEL_SCOPE=openid profile email

# Optional: preselect external identity providers configured in ZITADEL
# VITE_ZITADEL_GOOGLE_IDP_HINT=your-google-idp-id
# VITE_ZITADEL_APPLE_IDP_HINT=your-apple-idp-id

# Optional app backend for reconciling ZITADEL identities with your app database
# Example endpoint expected by the frontend: POST {VITE_APP_API_BASE_URL}/auth/bootstrap
# VITE_APP_API_BASE_URL=https://your-api-domain.com/api
